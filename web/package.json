{
    "name": "ledger",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.vue",
        "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.vue --fix",
        "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx,.vue --max-warnings=0",
        "dev": "vite",
        "build": "npm run lint:check && vite build",
        "build:force": "vite build",
        "preview": "vite preview"
    },
    "dependencies": {
        "axios": "^1.11.0",
        "dayjs": "^1.11.13",
        "element-plus": "^2.11.1",
        "mitt": "^3.0.1",
        "vant": "^4.9.22",
        "vue": "^3.5.18",
        "vue-cookies": "^1.8.6",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.64.0",
        "@typescript-eslint/parser": "^8.64.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "eslint": "^10.7.0",
        "eslint-plugin-vue": "^10.9.2",
        "globals": "^17.7.0",
        "less": "^4.4.1",
        "typescript-eslint": "^8.64.0",
        "unplugin-auto-import": "^20.0.0",
        "unplugin-vue-components": "^29.0.0",
        "vite": "^7.1.2",
        "vue-eslint-parser": "^10.4.1"
    },
    "allowScripts": {
        "vue-demi@0.14.10": true,
        "esbuild@0.25.9": true
    }
}
